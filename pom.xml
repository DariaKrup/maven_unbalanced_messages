<?xml version="1.0" encoding="UTF-8"?>
<!--
  TW-104016 Path B verification fixture (server-side Maven metadata / Maven tab).

  Put this pom.xml in a VCS root, attach it to a build configuration with a
  Maven build step (pomLocation = pom.xml), then open the build type's Maven tab
  (/viewType.html?buildTypeId=<id>&tab=maven). The server resolves project
  metadata through the embedder (maven-embedder-api, bumped to 1.4.7.1 by the
  fix) — this path does NOT go through ValidatingLocalRepositoryManager, so this
  fixture exercises the library-level guard instead.

  The SNAPSHOT dependency forces a maven-metadata.xml lookup against the
  traversal-id repository. The artifact does not need to exist.

  Observable on a FIXED server: resolution is refused/contained and NOTHING is
  created at the traversal target /tmp/tc-traversal-probe-B. (The library may
  not throw the same message as Path A; the absence of an out-of-root write is
  the result that matters here.)
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>tw104016.probe</groupId>
  <artifactId>pathB-build</artifactId>
  <version>1.0</version>
  <packaging>jar</packaging>

  <repositories>
    <repository>
      <id>tw104016probe/../../../../../../../../../../tmp/tc-traversal-probe-B</id>
      <url>https://repo.maven.apache.org/maven2</url>
      <releases><enabled>true</enabled></releases>
      <snapshots><enabled>true</enabled></snapshots>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>tw104016.nonexistent</groupId>
      <artifactId>trigger-metadata</artifactId>
      <version>99.0-SNAPSHOT</version>
    </dependency>
  </dependencies>
</project>
